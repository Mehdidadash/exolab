# Database Configuration
DB_HOST=localhost
DB_NAME=exolabir_index
DB_USER=exolabir_admin
DB_PASS=your_password_here

# Site Configuration
BASE_URL=/
SITE_NAME=لابراتوار دیجیتال اگزولب
SITE_DESCRIPTION=خدمات لابراتوار دندانسازی دیجیتال، نمونه کار و لیست قیمت

# Session Key
USER_SESSION_KEY=exolab_user_id

# Uploads folder (optional). Default = "uploads" INSIDE the web/project root
