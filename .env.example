# Database Configuration
DB_HOST=localhost
DB_NAME=exolabir_index
DB_USER=exolabir_admin
DB_PASS=your_password_here

# Site Configuration
BASE_URL=/
SITE_NAME=لابراتوار دیجیتال اگزولب
SITE_DESCRIPTION=خدمات لابراتوار دندانسازی دیجیتال، نمونه کار و لیست قیمت

# Session Key
USER_SESSION_KEY=exolab_user_id

# Uploads folder (optional). Default = "uploads" INSIDE the web/project root
# (local: <project>/uploads, hosting: public_html/uploads).
# Only set this if the real path on your shared host differs from the default.
# UPLOADS_ROOT=/home/username/public_html/uploads

# ---- Database backup (cron/backup_db.php) ----
# How many days to keep old backups (older files are deleted automatically)
BACKUP_KEEP_DAYS=7
# Secret key for web access: https://site/cron/backup_db.php?key=...  (empty = web disabled)
BACKUP_KEY=
# auto = mysqldump first then PHP fallback | mysqldump = binary only | php = PHP dumper only
BACKUP_METHOD=auto
# Optional: full path to mysqldump binary (empty = auto-detect)
MYSQLDUMP_PATH=
# Optional: backup filename prefix (default = DB_NAME)
BACKUP_FILE_PREFIX=